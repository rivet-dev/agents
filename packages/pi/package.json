{
	"name": "@rivet-dev/pi",
	"version": "0.5.1",
	"description": "Run the Pi coding agent as a durable Rivet Actor",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/rivet-dev/agents.git",
		"directory": "packages/pi"
	},
	"homepage": "https://rivet.dev/agents/docs/pi",
	"bugs": "https://github.com/rivet-dev/agents/issues",
	"keywords": [
		"pi",
		"coding-agent",
		"agent",
		"ai",
		"rivet",
		"rivetkit",
		"actors",
		"durable"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"files": [
		"dist",
		"package.json"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./durable": {
			"types": "./dist/durable.d.ts",
			"default": "./dist/durable.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^1.0.4",
		"@opentelemetry/api": "^1.1.0",
		"@rivet-dev/sandbox-adapter": "workspace:*"
	},
	"peerDependencies": {
		"@earendil-works/chord": "^1.0.0",
		"@earendil-works/pi-durable": "^1.0.0",
		"rivetkit": ">=2.3.23 <2.4.0"
	},
	"devDependencies": {
		"@earendil-works/chord": "^1.0.4",
		"@earendil-works/pi-ai": "^1.0.4",
		"@earendil-works/pi-durable": "^1.0.4",
		"@opentelemetry/sdk-trace-node": "2.11.0",
		"@types/node": "^24.0.0",
		"rivetkit": "2.3.23",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
