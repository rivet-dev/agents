{
	"name": "@rivet-dev/nanocodex",
	"version": "0.5.0",
	"private": true,
	"description": "Run the Nanocodex coding agent as a durable Rivet Actor",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
