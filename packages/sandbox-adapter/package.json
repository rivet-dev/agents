{
	"name": "@rivet-dev/sandbox-adapter",
	"version": "0.5.4",
	"description": "Sandbox providers for agent harnesses running in Rivet Actors",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/rivet-dev/agents.git",
		"directory": "packages/sandbox-adapter"
	},
	"homepage": "https://rivet.dev/agents/docs/sandboxes",
	"bugs": "https://github.com/rivet-dev/agents/issues",
	"keywords": [
		"sandbox",
		"e2b",
		"daytona",
		"freestyle",
		"docker",
		"agent",
		"ai",
		"rivet",
		"actors"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"files": [
		"dist",
		"package.json"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./agentos": {
			"types": "./dist/agentos.d.ts",
			"default": "./dist/agentos.js"
		},
		"./e2b": {
			"types": "./dist/e2b.d.ts",
			"default": "./dist/e2b.js"
		},
		"./daytona": {
			"types": "./dist/daytona.d.ts",
			"default": "./dist/daytona.js"
		},
		"./docker": {
			"types": "./dist/docker.d.ts",
			"default": "./dist/docker.js"
		},
		"./freestyle": {
			"types": "./dist/freestyle.d.ts",
			"default": "./dist/freestyle.js"
		},
		"./pi": {
			"types": "./dist/pi/index.d.ts",
			"default": "./dist/pi/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@daytonaio/sdk": "^0.216.0",
		"@earendil-works/chord": "^1.4.0",
		"@earendil-works/pi-durable": "^1.4.0",
		"e2b": "^2.51.0",
		"freestyle": "^0.2.16"
	},
	"peerDependenciesMeta": {
		"@daytonaio/sdk": {
			"optional": true
		},
		"@earendil-works/chord": {
			"optional": true
		},
		"@earendil-works/pi-durable": {
			"optional": true
		},
		"e2b": {
			"optional": true
		},
		"freestyle": {
			"optional": true
		}
	},
	"devDependencies": {
		"@daytonaio/sdk": "^0.216.0",
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@types/node": "^24.0.0",
		"e2b": "^2.51.0",
		"freestyle": "^0.2.16",
		"typescript": "^5.9.2",
		"vitest": "3.2.7"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
