{
	"name": "@rivet-dev/agents-workspace",
	"private": true,
	"license": "Apache-2.0",
	"packageManager": "pnpm@9.15.0",
	"scripts": {
		"prepare": "git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || true",
		"build": "pnpm -r --filter './packages/*' build",
		"check-types": "pnpm -r --if-present check-types",
		"test": "pnpm -r --filter './packages/*' --if-present test",
		"lint": "pnpm biome check .",
		"fmt": "pnpm biome check --write --diagnostic-level=error .",
		"check-boundaries": "node scripts/check-boundaries.mjs",
		"test:packed": "node scripts/test-packed.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"lefthook": "^2.1.3",
		"tsx": "^4.21.0"
	}
}
